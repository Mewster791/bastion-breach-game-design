{
  "name": "bastionbreach-desktop",
  "version": "1.0.0",
  "description": "Bastion Breach desktop app",
  "author": "Nativize",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-serve": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.lovable.bastionbreach",
    "productName": "Bastion Breach",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "out"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
